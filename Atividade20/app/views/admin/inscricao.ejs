<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscrição - Semana de Tecnologia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">Semana de Tecnologia</a>
            <div class="navbar-nav">
                <a class="nav-link" href="/">Home</a>
                <a class="nav-link" href="/sobre">Sobre</a>
                <a class="nav-link" href="/programacao">Programação</a>
                <a class="nav-link" href="/contato">Contato</a>
                <a class="nav-link active" href="/admin/inscricao">Inscrição</a>
                <a class="nav-link" href="/novidades">Novidades</a>
            </div>
        </div>
    </nav>

    <div class="container" style="max-width: 650px;">
        <h2>Inscrição de Participantes</h2>
        <hr>

        <form action="">
            <div class="mb-3">
                <label for="nome" class="form-label">Nome Completo</label>
                <input type="text" class="form-control" id="nome" name="nome">
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">E-mail</label>
                <input type="email" class="form-control" id="email" name="email">
            </div>

            <div class="mb-3">
                <label for="ra" class="form-label">RA / Matrícula</label>
                <input type="text" class="form-control" id="ra" name="ra">
            </div>

            <div class="mb-3">
                <label for="curso" class="form-label">Curso</label>
                <input type="text" class="form-control" id="curso" name="curso">
            </div>

            <div class="mb-3">
                <label for="oficina" class="form-label">Oficina de Interesse</label>
                <select class="form-select" id="oficina" name="oficina">
                    <option value="node">Workshop: Node.js e Express</option>
                    <option value="ia">Palestra: Inteligência Artificial</option>
                    <option value="nuvem">Palestra: Computação em Nuvem</option>
                    <option value="seguranca">Workshop: Segurança da Informação</option>
                    <option value="hackathon">Hackathon de Desenvolvimento</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Cadastrar</button>
            <a href="/" class="btn btn-outline-secondary ms-2">Voltar</a>
        </form>
    </div>
</body>
</html>
